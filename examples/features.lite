fn control_flow() {
    let x = 1;
    
    while x < 10 {
        break;
    }
    
    loop {
        break;
    }
    
    for i in 0..10 {
        continue;
    }
    
    match x {
        0 => 1,
        1 => 2,
        _ => 3,
    };
    
    let y = || 1;
    let z = |a| a + 1;
    
    let arr = [1, 2, 3];
    let repeat = [0; 4];
    
    let tup = (1, 2, 3);
    let unit = ();
    
    let p: *mut i32 = &mut x;
    let q: *i32 = &x;
    let d = *p;
    
    defer cleanup();
}

