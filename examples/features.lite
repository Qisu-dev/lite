trait Display {
    type Output;
    fn fmt(self) -> i32;
}

impl Point {
    fn new(x: i32, y: i32) -> i32 {
        Point { x, y }
    }
}

impl Display for Point {
    type Output = i32;
    fn fmt(self) -> i32 {
        self.x
    }
}

